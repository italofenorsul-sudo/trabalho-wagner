# Variáveis de ambiente opcionais do back-end (copie para ".env" na raiz do
# projeto se quiser sobrescrever os padrões — o servidor funciona sem isso).

# Porta HTTP do servidor
PORT=3000

# Segredo usado para assinar o cookie de sessão. Se não for definido, um
# valor aleatório é gerado automaticamente e salvo em data/.session-secret
# (fora do controle de versão) na primeira execução.
SESSION_SECRET=

# Desativa o cluster (balanceamento de carga entre múltiplos processos),
# útil em ambientes que não suportam múltiplos processos (ex: alguns
# serviços serverless). Padrão: cluster ativado.
SCL_SEM_CLUSTER=false
